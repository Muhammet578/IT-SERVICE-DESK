{% extends 'base.html.twig' %}

{% block title %}Пользователи | IT Service Desk{% endblock %}

{% block body %}

    <div class="isd-users">

        {# Заголовок страницы #}
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

            <div>
                <span class="isd-users-kicker">
                    АДМИНИСТРИРОВАНИЕ
                </span>

                <h1 class="h2 fw-bold mt-2 mb-2">
                    Пользователи
                </h1>

                <p class="isd-users-description mb-0">
                    Управление учётными записями сотрудников.
                </p>
            </div>

            {% if is_granted('ROLE_MANAGER') %}
                <a
                    href="{{ path('app_users_new') }}"
                    class="btn isd-users-primary"
                >
                    <span aria-hidden="true">＋</span>
                    Добавить пользователя
                </a>
            {% endif %}

        </div>

        {# Информационный блок #}
        <section class="isd-users-hero rounded-4 mb-4">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-4">

                <div>
                    <span class="isd-users-hero-label">
                        УЧЁТНЫЕ ЗАПИСИ
                    </span>

                    <h2 class="h3 fw-bold mt-3 mb-2">
                        Управление сотрудниками
                    </h2>

                    <p class="mb-0">
                        Находите пользователей, просматривайте
                        их данные и переходите к редактированию.
                    </p>
                </div>

                <div class="isd-users-counter">
                    <span>НАЙДЕНО</span>

                    <strong>
                        {{ total }}
                    </strong>

                    <small>пользователей</small>
                </div>

            </div>

        </section>

        {# Поиск и сортировка #}
        <section class="card isd-users-panel mb-4">

            <div class="card-body p-4">

                <form
                    method="get"
                    action="{{ path('app_users') }}"
                    class="row g-3 align-items-end"
                >

                    <div class="col-lg-6">

                        <label
                            for="users-search"
                            class="form-label fw-semibold"
                        >
                            Поиск пользователя
                        </label>

                        <input
                            id="users-search"
                            type="search"
                            name="search"
                            class="form-control"
                            placeholder="Имя или email"
                            value="{{ search }}"
                        >

                    </div>

                    <div class="col-lg-3">

                        <label
                            for="users-sort"
                            class="form-label fw-semibold"
                        >
                            Сортировка
                        </label>

                        <select
                            id="users-sort"
                            name="sort"
                            class="form-select"
                        >
                            <option
                                value="id"
                                {{ sort == 'id' ? 'selected' : '' }}
                            >
                                По ID
                            </option>

                            <option
                                value="name"
                                {{ sort == 'name' ? 'selected' : '' }}
                            >
                                По имени
                            </option>

                            <option
                                value="email"
                                {{ sort == 'email' ? 'selected' : '' }}
                            >
                                По email
                            </option>

                        </select>

                    </div>

                    <div class="col-lg-3">

                        <div class="d-flex gap-2">

                            <button
                                type="submit"
                                class="btn isd-users-primary flex-grow-1"
                            >
                                Найти
                            </button>

                            <a
                                href="{{ path('app_users') }}"
                                class="btn isd-users-secondary"
                                title="Сбросить фильтры"
                                aria-label="Сбросить фильтры"
                            >
                                ↺
                            </a>

                        </div>

                    </div>

                </form>

            </div>

        </section>

        {# Список пользователей #}
        <section class="card isd-users-panel mb-4">

            <div class="card-header p-4">

                <div class="d-flex justify-content-between align-items-center gap-3">

                    <h2 class="h5 fw-bold mb-0">
                        Список пользователей
                    </h2>

                    <span class="isd-users-count-badge">
                        {{ total }}
                    </span>

                </div>

            </div>

            <div class="table-responsive">

                <table class="table isd-users-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">ID</th>
                            <th scope="col">Пользователь</th>
                            <th scope="col">Email</th>
                            <th scope="col" class="text-end pe-4">
                                Действия
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for user in users %}

                            <tr>

                                <td class="ps-4">
                                    <span class="isd-users-id">
                                        #{{ user.id }}
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-3">

                                        <div class="isd-users-avatar" aria-hidden="true">
                                            {{ user.name|slice(0, 1)|upper }}
                                        </div>

                                        <span class="isd-users-name">
                                            {{ user.name }}
                                        </span>

                                    </div>
                                </td>

                                <td class="isd-users-email">
                                    {{ user.email }}
                                </td>

                                <td class="text-end pe-4">

                                    <a
                                        href="{{ path('app_users_edit', {id: user.id}) }}"
                                        class="btn isd-users-edit btn-sm"
                                    >
                                        Редактировать
                                    </a>

                                </td>

                            </tr>

                        {% else %}

                            <tr>
                                <td colspan="4">

                                    <div class="isd-users-empty">

                                        <div class="isd-users-empty-icon">
                                            🔎
                                        </div>

                                        <h3 class="h5 fw-bold">
                                            Пользователи не найдены
                                        </h3>

                                        <p class="isd-users-description mb-3">
                                            Попробуйте изменить поисковый запрос.
                                        </p>

                                        <a
                                            href="{{ path('app_users') }}"
                                            class="btn isd-users-secondary"
                                        >
                                            Сбросить поиск
                                        </a>

                                    </div>

                                </td>
                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </section>

        {# Пагинация #}
        {% if totalPages > 1 %}

            <nav aria-label="Страницы пользователей">

                <ul class="pagination isd-users-pagination justify-content-center flex-wrap gap-1">

                    <li class="page-item {{ page == 1 ? 'disabled' : '' }}">

                        {% if page > 1 %}

                            <a
                                class="page-link"
                                href="{{ path('app_users', {
                                page: page - 1,
                                search: search,
                                sort: sort
                            }) }}"
                            >
                                ← Назад
                            </a>

                        {% else %}

                            <span class="page-link">
                                ← Назад
                            </span>

                        {% endif %}

                    </li>

                    {% for number in 1..totalPages %}

                        <li class="page-item {{ page == number ? 'active' : '' }}">

                            <a
                                class="page-link"
                                href="{{ path('app_users', {
                                page: number,
                                search: search,
                                sort: sort
                            }) }}"
                                {% if page == number %}
                                aria-current="page"
                                {% endif %}
                            >
                                {{ number }}
                            </a>

                        </li>

                    {% endfor %}

                    <li class="page-item {{ page == totalPages ? 'disabled' : '' }}">

                        {% if page < totalPages %}

                            <a
                                class="page-link"
                                href="{{ path('app_users', {
                                page: page + 1,
                                search: search,
                                sort: sort
                            }) }}"
                            >
                                Вперёд →
                            </a>

                        {% else %}

                            <span class="page-link">
                                Вперёд →
                            </span>

                        {% endif %}

                    </li>

                </ul>

            </nav>

        {% endif %}

    </div>

{% endblock %}