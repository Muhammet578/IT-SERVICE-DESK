{% extends 'base.html.twig' %}

{% block title %}IT Service Desk{% endblock %}

{% block body %}
    <main> 
        <h1>Пользователи</h1>
        <p class="text-muted">
            Найдено пользователей: {{ total }}
        </p>
        <form method="get" action="{{ path('app_users') }}" class="row g-3 mb-4">

            <div class="col-md-6">
                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Поиск по имени или email"
                    value="{{ search }}"
                >
            </div>

            <div class="col-md-4">
                <select name="sort" class="form-select">
                    <option value="id" {{ sort == 'id' ? 'selected' : '' }}>
                        По ID
                    </option>
                    <option value="name" {{ sort == 'name' ? 'selected' : '' }}>
                        По имени
                    </option>
                    <option value="email" {{ sort == 'email' ? 'selected' : '' }}>
                        По email
                    </option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Найти
                </button>
            </div>

        </form>
        <ul class="list-group">
            {% for user in users %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>
                        {{ user.id }} — {{ user.name }} — {{ user.email }}
                    </span>

                    <a
                        href="{{ path('app_users_edit', {id: user.id}) }}"
                        class="btn btn-sm btn-outline-primary"
                    >
                        Редактировать
                    </a>
                </li>
            {% else %}
                <li class="list-group-item text-muted">
                    Пользователи не найдены.
                </li>
            {% endfor %}
        </ul>
        {% if totalPages > 1 %}
            <nav class="mt-4" aria-label="Страницы пользователей">
                <ul class="pagination justify-content-center">

                    {# Предыдущая страница #}
                    <li class="page-item {{ page == 1 ? 'disabled' : '' }}">
                        {% if page > 1 %}
                            <a
                                class="page-link"
                                href="{{ path('app_users', {
                           page: page - 1,
                           search: search,
                           sort: sort
                       }) }}"
                            >
                                Назад
                            </a>
                        {% else %}
                            <span class="page-link">Назад</span>
                        {% endif %}
                    </li>

                    {# Номера страниц #}
                    {% for number in 1..totalPages %}
                        <li class="page-item {{ page == number ? 'active' : '' }}">
                            <a
                                class="page-link"
                                href="{{ path('app_users', {
                           page: number,
                           search: search,
                           sort: sort
                       }) }}"
                            >
                                {{ number }}
                            </a>
                        </li>
                    {% endfor %}

                    {# Следующая страница #}
                    <li class="page-item {{ page == totalPages ? 'disabled' : '' }}">
                        {% if page < totalPages %}
                            <a
                                class="page-link"
                                href="{{ path('app_users', {
                           page: page + 1,
                           search: search,
                           sort: sort
                       }) }}"
                            >
                                Вперёд
                            </a>
                        {% else %}
                            <span class="page-link">Вперёд</span>
                        {% endif %}
                    </li>

                </ul>
            </nav>
        {% endif %}
        
    </main>
{% endblock %}
