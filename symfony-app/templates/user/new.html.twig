{% extends 'base.html.twig' %}

{% block title %}Создание пользователя{% endblock %}

{% block body %}
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h3 mb-4">Создание пользователя</h1>

            {{ form_start(form) }}

                {{ form_errors(form) }}

                <div class="mb-3">
                    {{ form_row(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.email) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.plainPassword) }}
                </div>

                <button type="submit" class="btn btn-primary">
                    Создать пользователя
                </button>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
