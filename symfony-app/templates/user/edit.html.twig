{% extends 'base.html.twig' %}

{% block title %}Редактирование пользователя{% endblock %}

{% block body %}
    <div class="card shadow-sm">
        <div class="card-body">
            <h1 class="h3 mb-4">
                Редактирование пользователя #{{ user.id }}
            </h1>

            {{ form_start(form) }}

                {{ form_errors(form) }}

                <div class="mb-3">
                    {{ form_row(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_row(form.email) }}
                </div>

                <button type="submit" class="btn btn-primary">
                    Сохранить изменения
                </button>

                <a
                    href="{{ path('app_users') }}"
                    class="btn btn-secondary"
                >
                    Отмена
                </a>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}