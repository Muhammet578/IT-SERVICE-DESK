{% extends 'base.html.twig' %}

{% block title %}Мой профиль | IT Service Desk{% endblock %}

{% block body %}

    {% set roleLabels = {
    'admin': 'Администратор',
    'manager': 'Менеджер',
    'technician': 'Специалист поддержки',
    'user': 'Пользователь'
} %}

    <div class="isd-profile">

        {# Заголовок #}
        <div class="mb-4">
            <span class="isd-profile-kicker">
                ЛИЧНЫЙ КАБИНЕТ
            </span>

            <h1 class="h2 fw-bold mt-2 mb-2">
                Мой профиль
            </h1>

            <p class="isd-profile-description mb-0">
                Информация о вашей учётной записи в IT Service Desk.
            </p>
        </div>

        {# Шапка профиля #}
        <section class="isd-profile-hero rounded-4 mb-4">

            <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-4">

                <div class="isd-profile-avatar" aria-hidden="true">
                    {{ user.name|slice(0, 1)|upper }}
                </div>

                <div class="flex-grow-1">

                    <span class="isd-profile-hero-label">
                        УЧЁТНАЯ ЗАПИСЬ
                    </span>

                    <h2 class="h3 fw-bold mt-2 mb-2">
                        {{ user.name }}
                    </h2>

                    <p class="isd-profile-hero-email mb-3">
                        {{ user.email }}
                    </p>

                    <span class="isd-profile-hero-role">
                        {{ roleLabels[user.role.name]|default(user.role.name) }}
                    </span>

                </div>

                <div>
                    {% if user.active %}
                        <span class="isd-profile-status isd-profile-status--active">
                            <span class="isd-profile-status-dot"></span>
                            Аккаунт активен
                        </span>
                    {% else %}
                        <span class="isd-profile-status isd-profile-status--blocked">
                            <span class="isd-profile-status-dot"></span>
                            Аккаунт заблокирован
                        </span>
                    {% endif %}
                </div>

            </div>

        </section>

        {# Данные пользователя #}
        <section class="card isd-profile-card mb-4">

            <div class="card-header p-4">
                <h2 class="h5 fw-bold mb-1">
                    Информация об аккаунте
                </h2>

                <p class="isd-profile-description small mb-0">
                    Основные данные вашей учётной записи.
                </p>
            </div>

            <div class="card-body p-4">

                <dl class="isd-profile-grid mb-0">

                    <div class="isd-profile-field">
                        <dt>Полное имя</dt>
                        <dd>{{ user.name }}</dd>
                    </div>

                    <div class="isd-profile-field">
                        <dt>Электронная почта</dt>
                        <dd class="isd-profile-email">
                            {{ user.email }}
                        </dd>
                    </div>

                    <div class="isd-profile-field">
                        <dt>Роль в системе</dt>
                        <dd>
                            <span class="isd-profile-role">
                                {{ roleLabels[user.role.name]|default(user.role.name) }}
                            </span>
                        </dd>
                    </div>

                    <div class="isd-profile-field">
                        <dt>Дата регистрации</dt>
                        <dd>
                            {{ user.createdAt|date('d.m.Y H:i') }}
                        </dd>
                    </div>

                    <div class="isd-profile-field">
                        <dt>Статус аккаунта</dt>
                        <dd>
                            {% if user.active %}
                                <span class="isd-profile-account-active">
                                    ● Активен
                                </span>
                            {% else %}
                                <span class="isd-profile-account-blocked">
                                    ● Заблокирован
                                </span>
                            {% endif %}
                        </dd>
                    </div>

                </dl>

            </div>

        </section>

        {# Навигация #}
        <div class="d-flex flex-wrap gap-3">

            <a
                href="{{ path('app_home') }}"
                class="btn isd-profile-button"
            >
                ← Вернуться на главную
            </a>

            <a
                href="{{ path('app_tickets') }}"
                class="btn isd-profile-button-outline"
            >
                Мои заявки →
            </a>

        </div>

    </div>

{% endblock %}