{% set currentRoute = app.request.attributes.get('_route')|default('') %}

{% set roleLabels = {
    'admin': 'Администратор',
    'manager': 'Менеджер',
    'technician': 'Специалист поддержки',
    'user': 'Пользователь'
} %}

<nav class="navbar navbar-expand-lg navbar-gta6 sticky-top">
    <div class="container py-2">

        {# Логотип #}
        <a
            class="navbar-brand d-flex align-items-center gap-2 fw-bold"
            href="{{ app.user ? path('app_home') : path('app_login') }}"
        >
            <span
                class="d-inline-flex align-items-center justify-content-center gta-brand-badge"
            >
                IT
            </span>

            <span class="gta-brand-text">
                SERVICE<span class="brand-accent">DESK</span>
            </span>
        </a>

        {# Мобильное меню #}
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNavbar"
            aria-controls="mainNavbar"
            aria-expanded="false"
            aria-label="Открыть меню"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

            {% if app.user %}

                {# Основная навигация #}
                <div class="navbar-nav mx-auto gap-lg-1">

                    <a
                        class="nav-link px-3 gta-link {{ currentRoute == 'app_home' ? 'active fw-semibold' : '' }}"
                        href="{{ path('app_home') }}"
                    >
                        Главная
                    </a>

                    <a
                        class="nav-link px-3 gta-link {{ currentRoute == 'app_dashboard' ? 'active fw-semibold' : '' }}"
                        href="{{ path('app_dashboard') }}"
                    >
                        Панель управления
                    </a>

                    <a
                        class="nav-link px-3 gta-link {{ currentRoute starts with 'app_tickets' or currentRoute == 'find_tickets' ? 'active fw-semibold' : '' }}"
                        href="{{ path('app_tickets') }}"
                    >
                        Заявки
                    </a>

                    {% if is_granted('ROLE_ADMIN') %}
                        <a
                            class="nav-link px-3 gta-link {{ currentRoute starts with 'app_users' ? 'active fw-semibold' : '' }}"
                            href="{{ path('app_users') }}"
                        >
                            Пользователи
                        </a>
                    {% endif %}

                    {# Мой профиль с выпадающей карточкой #}
                    <div class="nav-item dropdown profile-dropdown">

                        <div class="d-flex align-items-center">

                            <a
                                class="nav-link px-3 gta-link {{ currentRoute == 'app_profile' ? 'active fw-semibold' : '' }}"
                                href="{{ path('app_profile') }}"
                            >
                                Мой профиль
                            </a>

                            <button
                                type="button"
                                class="profile-dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Показать данные профиля"
                            >
                                ▾
                            </button>

                        </div>

                        {# Карточка пользователя #}
                        <div
                            class="dropdown-menu dropdown-menu-end profile-dropdown-menu p-3"
                        >

                            <div class="mb-3">
                                <span class="gta-auth-badge">
                                    Авторизован
                                </span>
                            </div>

                            <div class="profile-dropdown-label">
                                Пользователь
                            </div>

                            <div class="profile-dropdown-name">
                                {{ app.user.name }}
                            </div>

                            <div class="profile-dropdown-label mt-3">
                                Электронная почта
                            </div>

                            <div class="profile-dropdown-email">
                                {{ app.user.email }}
                            </div>

                            <div class="profile-dropdown-label mt-3">
                                Роль в системе
                            </div>

                            <div class="profile-dropdown-role">
                                {{ roleLabels[app.user.role.name]|default(app.user.role.name) }}
                            </div>

                            <hr class="profile-dropdown-divider">

                            <a
                                href="{{ path('app_profile') }}"
                                class="btn btn-gta-primary btn-sm w-100 rounded-3"
                            >
                                Открыть профиль
                            </a>

                        </div>
                    </div>

                    <a
                        class="nav-link px-3 gta-link {{ currentRoute == 'app_about' ? 'active fw-semibold' : '' }}"
                        href="{{ path('app_about') }}"
                    >
                        О проекте
                    </a>

                </div>

                {# Правая часть: тема и действия #}
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-lg-0">

                    {# Переключатель темы #}
                    <button
                        type="button"
                        class="theme-toggle"
                        id="theme-toggle"
                        aria-label="Переключить тему оформления"
                    >
                        ☀️ Classic
                    </button>

                    {# Создание пользователя #}
                    {% if is_granted('ROLE_MANAGER') %}
                        <a
                            href="{{ path('app_users_new') }}"
                            class="btn btn-gta-primary btn-sm rounded-3"
                        >
                            + Пользователь
                        </a>
                    {% endif %}

                    {# Безопасный выход #}
                    <form
                        action="{{ path('app_logout') }}"
                        method="post"
                        class="m-0"
                    >
                        <input
                            type="hidden"
                            name="_csrf_token"
                            value="{{ csrf_token('logout') }}"
                        >

                        <button
                            type="submit"
                            class="btn btn-gta-danger btn-sm rounded-3"
                        >
                            Выход
                        </button>
                    </form>

                </div>

            {% else %}

                {# Меню для гостя #}
                <div class="ms-lg-auto d-flex flex-wrap align-items-center gap-3 mt-3 mt-lg-0">

                    <button
                        type="button"
                        class="theme-toggle"
                        id="theme-toggle"
                        aria-label="Переключить тему оформления"
                    >
                        ☀️ Classic
                    </button>

                    <a
                        href="{{ path('app_login') }}"
                        class="btn btn-gta-primary rounded-3 px-4"
                    >
                        Войти
                    </a>

                </div>

            {% endif %}

        </div>
    </div>
</nav>