{% extends 'base.html.twig' %}

{% block title %}
    Заявка №{{ ticket.id }} | IT Service Desk
{% endblock %}

{% block body %}

    {# Определяем цвет текущего статуса #}
    {% set statusClass = 'isd-ticket-status-default' %}

    {% if ticket.status == 'Новая' %}
        {% set statusClass = 'isd-ticket-status-new' %}
    {% elseif ticket.status == 'В работе' %}
        {% set statusClass = 'isd-ticket-status-progress' %}
    {% elseif ticket.status == 'Решена' %}
        {% set statusClass = 'isd-ticket-status-resolved' %}
    {% elseif ticket.status == 'Закрыта' %}
        {% set statusClass = 'isd-ticket-status-closed' %}
    {% endif %}

    <div class="isd-tickets isd-ticket-detail">

        {# Заголовок страницы #}
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">

            <div>
                <span class="isd-tickets-kicker">
                    ТЕХНИЧЕСКАЯ ПОДДЕРЖКА
                </span>

                <h1 class="h2 fw-bold mt-2 mb-2">
                    Заявка #{{ ticket.id }}
                </h1>

                <p class="isd-tickets-description mb-0">
                    Подробная информация об обращении.
                </p>
            </div>

            <a
                href="{{ path('app_tickets') }}"
                class="btn isd-tickets-secondary"
            >
                ← Назад к заявкам
            </a>

        </div>

        {# Верхний информационный блок #}
        <section class="isd-tickets-hero rounded-4 mb-4">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="isd-tickets-hero-label">
                        IT SERVICE DESK · ОБРАЩЕНИЕ #{{ ticket.id }}
                    </span>

                    <h2 class="h3 fw-bold mt-3 mb-3">
                        {{ ticket.title }}
                    </h2>

                    <p class="mb-0">
                        Информация о заявке и её текущем состоянии
                        в системе технической поддержки.
                    </p>

                </div>

                <div class="col-lg-4 text-lg-end">

                    <div class="isd-ticket-detail-hero-info">

                        <span class="isd-ticket-detail-hero-caption">
                            ТЕКУЩИЙ СТАТУС
                        </span>

                        <div class="mt-3">

                            <span class="isd-ticket-status {{ statusClass }}">

                                <span
                                    class="isd-ticket-status-dot"
                                    aria-hidden="true"
                                ></span>

                                {{ ticket.status }}

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        {# Карточка заявки #}
        <section class="card isd-ticket-detail-card mb-4">

            <div class="card-header p-4">

                <h2 class="h5 fw-bold mb-1">
                    Информация о заявке
                </h2>

                <p class="isd-tickets-description small mb-0">
                    Основные данные обращения.
                </p>

            </div>

            <div class="card-body p-4">

                <dl class="isd-ticket-detail-grid mb-0">

                    {# Номер заявки #}
                    <div class="isd-ticket-detail-field">

                        <dt class="isd-ticket-detail-label">
                            Номер заявки
                        </dt>

                        <dd class="isd-ticket-detail-value">
                            #{{ ticket.id }}
                        </dd>

                    </div>

                    {# Название заявки #}
                    <div class="isd-ticket-detail-field">

                        <dt class="isd-ticket-detail-label">
                            Название
                        </dt>

                        <dd class="isd-ticket-detail-value">
                            {{ ticket.title }}
                        </dd>

                    </div>

                    {# Статус #}
                    <div class="isd-ticket-detail-field">

                        <dt class="isd-ticket-detail-label">
                            Текущий статус
                        </dt>

                        <dd class="mb-0">

                            <span class="isd-ticket-status {{ statusClass }}">

                                <span
                                    class="isd-ticket-status-dot"
                                    aria-hidden="true"
                                ></span>

                                {{ ticket.status }}

                            </span>

                        </dd>

                    </div>

                </dl>

                {# Описание, если контроллер передаёт это поле #}
                {% if ticket.description is defined and ticket.description is not empty %}

                    <div class="isd-ticket-detail-description mt-4">

                        <h3 class="h6 fw-bold mb-3">
                            Описание проблемы
                        </h3>

                        <p class="mb-0">
                            {{ ticket.description }}
                        </p>

                    </div>

                {% endif %}

            </div>

            {# Доступные действия #}
            <div class="card-footer isd-ticket-detail-footer p-4">

                <div class="d-flex flex-wrap gap-3">

                    <a
                        href="{{ path('app_tickets') }}"
                        class="btn isd-tickets-secondary"
                    >
                        ← К списку заявок
                    </a>

                    {# Редактирование через TicketVoter #}
                    {% if is_granted('EDIT', ticketEntity) %}

                        <a
                            href="{{ path('app_tickets_edit', {id: ticket.id}) }}"
                            class="btn isd-tickets-primary"
                        >
                            ✏️ Редактировать
                        </a>

                    {% endif %}

                    {# Изменение статуса через TicketVoter #}
                    {% if is_granted('CHANGE_STATUS', ticketEntity) %}

                        <a
                            href="{{ path('app_tickets_status', {id: ticket.id}) }}"
                            class="btn isd-ticket-detail-status-button"
                        >
                            Изменить статус →
                        </a>

                    {% endif %}

                </div>

            </div>

        </section>

    </div>

{% endblock %}