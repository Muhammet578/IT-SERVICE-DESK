{% extends 'base.html.twig' %}

{% block title %}IT Service Desk{% endblock %}

{% block body %}
    <main> 
        <h1>Заявки</h1>
        
        <ul>
            {% for ticket in tickets %}
                <li>
                    <a href="{{ path('find_tickets', {id: ticket.id}) }}">
                        {{ ticket.title }} </a>
                    {{ ticket.status }} </li>    
            {% endfor %}
        </ul>
        
    </main>
{% endblock %}
