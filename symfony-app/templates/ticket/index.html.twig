{% extends 'base.html.twig' %}

{% block title %}Заявки | IT Service Desk{% endblock %}

{% block body %}

    <div class="isd-tickets">

        {# Заголовок #}
        <div class="mb-4">

            <span class="isd-tickets-kicker">
                ТЕХНИЧЕСКАЯ ПОДДЕРЖКА
            </span>

            <h1 class="h2 fw-bold mt-2 mb-2">
                Заявки
            </h1>

            <p class="isd-tickets-description mb-0">
                Просмотр и управление доступными вам обращениями.
            </p>

        </div>

        {# Приветственный блок #}
        <section class="isd-tickets-hero rounded-4 mb-4">

            <div class="row align-items-center g-4">

                <div class="col-md-8">

                    <span class="isd-tickets-hero-label">
                        IT SERVICE DESK
                    </span>

                    <h2 class="h3 fw-bold mt-3 mb-3">
                        Все обращения
                        <span class="isd-tickets-hero-highlight">
                            под контролем.
                        </span>
                    </h2>

                    <p class="mb-0">
                        Просматривайте обращения сотрудников,
                        отслеживайте их статусы и работайте
                        с доступными вам заявками.
                    </p>

                </div>

                <div class="col-md-4 text-md-end">

                    <div class="isd-tickets-counter">

                        <span>НАЙДЕНО ЗАЯВОК</span>

                        <strong>{{ total }}</strong>

                        <small>
                            {% if selectedStatusId is null %}
                                Все статусы
                            {% else %}
                                С учётом фильтра
                            {% endif %}
                        </small>

                    </div>

                </div>

            </div>

        </section>

        {# Фильтрация #}
        <section class="card isd-tickets-panel mb-4">

            <div class="card-body p-4">

                <div class="mb-3">
                    <h2 class="h5 fw-bold mb-1">
                        Фильтрация заявок
                    </h2>

                    <p class="isd-tickets-description small mb-0">
                        Выберите статус для поиска обращений.
                    </p>
                </div>

                <form
                    action="{{ path('app_tickets') }}"
                    method="get"
                    class="row g-3 align-items-end"
                >

                    <div class="col-lg-7">

                        <label
                            for="ticket-status-filter"
                            class="form-label fw-semibold"
                        >
                            Статус заявки
                        </label>

                        <select
                            id="ticket-status-filter"
                            name="status"
                            class="form-select"
                        >

                            <option
                                value="all"
                                {{ selectedStatusId is null ? 'selected' : '' }}
                            >
                                Все статусы
                            </option>

                            {% for status in statuses %}

                                <option
                                    value="{{ status.id }}"
                                    {{ selectedStatusId == status.id ? 'selected' : '' }}
                                >
                                    {{ status.name }}
                                </option>

                            {% endfor %}

                        </select>

                    </div>

                    <div class="col-lg-5">

                        <div class="d-flex flex-wrap gap-2">

                            <button
                                type="submit"
                                class="btn isd-tickets-primary flex-grow-1"
                            >
                                Применить фильтр
                            </button>

                            <a
                                href="{{ path('app_tickets', {status: 'all'}) }}"
                                class="btn isd-tickets-secondary"
                                title="Сбросить фильтр"
                                aria-label="Сбросить фильтр"
                            >
                                ↺
                            </a>

                        </div>

                    </div>

                </form>

            </div>

        </section>

        {# Таблица заявок #}
        <section class="card isd-tickets-panel mb-4">

            <div class="card-header p-4">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                    <h2 class="h5 fw-bold mb-0">
                        Список заявок
                    </h2>

                    <span class="isd-tickets-count-badge">
                        {{ total }}
                    </span>

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover isd-tickets-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">ID</th>
                            <th scope="col">Заявка</th>
                            <th scope="col">Описание</th>
                            <th scope="col">Статус</th>
                            <th scope="col" class="text-end pe-4">
                                Действия
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        {% for ticket in tickets %}

                            {# Оформление статуса #}
                            {% set statusClass = 'isd-ticket-status-default' %}

                            {% if ticket.status.name == 'Новая' %}
                                {% set statusClass = 'isd-ticket-status-new' %}
                            {% elseif ticket.status.name == 'В работе' %}
                                {% set statusClass = 'isd-ticket-status-progress' %}
                            {% elseif ticket.status.name == 'Решена' %}
                                {% set statusClass = 'isd-ticket-status-resolved' %}
                            {% elseif ticket.status.name == 'Закрыта' %}
                                {% set statusClass = 'isd-ticket-status-closed' %}
                            {% endif %}

                            <tr>

                                {# ID #}
                                <td class="ps-4">
                                    <span class="isd-tickets-id">
                                        #{{ ticket.id }}
                                    </span>
                                </td>

                                {# Название #}
                                <td>

                                    <a
                                        href="{{ path('find_tickets', {id: ticket.id}) }}"
                                        class="isd-tickets-title"
                                    >
                                        {{ ticket.title }}
                                    </a>

                                </td>

                                {# Описание #}
                                <td>

                                    <div class="isd-tickets-text">

                                        {{ ticket.description|slice(0, 100) }}

                                        {% if ticket.description|length > 100 %}
                                            …
                                        {% endif %}

                                    </div>

                                </td>

                                {# Статус #}
                                <td>

                                    <span class="isd-ticket-status {{ statusClass }}">
                                        <span
                                            class="isd-ticket-status-dot"
                                            aria-hidden="true"
                                        ></span>

                                        {{ ticket.status.name }}
                                    </span>

                                </td>

                                {# Действия #}
                                <td class="text-end pe-4">

                                    <div class="d-flex justify-content-end flex-wrap gap-2">

                                        <a
                                            href="{{ path('find_tickets', {id: ticket.id}) }}"
                                            class="btn btn-sm isd-tickets-open"
                                        >
                                            Открыть
                                        </a>

                                        {% if is_granted('EDIT', ticket) %}

                                            <a
                                                href="{{ path('app_tickets_edit', {id: ticket.id}) }}"
                                                class="btn btn-sm isd-tickets-edit"
                                            >
                                                Изменить
                                            </a>

                                        {% endif %}

                                    </div>

                                </td>

                            </tr>

                        {% else %}

                            {# Нет результатов #}
                            <tr>

                                <td colspan="5">

                                    <div class="isd-tickets-empty">

                                        <div
                                            class="isd-tickets-empty-icon"
                                            aria-hidden="true"
                                        >
                                            📭
                                        </div>

                                        <h3 class="h5 fw-bold mb-2">
                                            Заявки не найдены
                                        </h3>

                                        <p class="isd-tickets-description mb-3">
                                            Нет доступных заявок,
                                            соответствующих выбранному фильтру.
                                        </p>

                                        {% if selectedStatusId is not null %}

                                            <a
                                                href="{{ path('app_tickets', {status: 'all'}) }}"
                                                class="btn isd-tickets-secondary"
                                            >
                                                Сбросить фильтр
                                            </a>

                                        {% endif %}

                                    </div>

                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        </section>

        {# Пагинация #}
        {% if totalPages > 1 %}

            <nav
                class="mt-4"
                aria-label="Страницы заявок"
            >

                <ul class="pagination isd-tickets-pagination justify-content-center flex-wrap gap-1">

                    {# Назад #}
                    <li class="page-item {{ page == 1 ? 'disabled' : '' }}">

                        {% if page > 1 %}

                            <a
                                class="page-link"
                                href="{{ path('app_tickets', {
                                page: page - 1,
                                status: selectedStatusId ?? 'all'
                            }) }}"
                            >
                                ← Назад
                            </a>

                        {% else %}

                            <span class="page-link">
                                ← Назад
                            </span>

                        {% endif %}

                    </li>

                    {# Страницы #}
                    {% for number in 1..totalPages %}

                        <li class="page-item {{ number == page ? 'active' : '' }}">

                            <a
                                class="page-link"
                                href="{{ path('app_tickets', {
                                page: number,
                                status: selectedStatusId ?? 'all'
                            }) }}"
                                {% if number == page %}
                                aria-current="page"
                                {% endif %}
                            >
                                {{ number }}
                            </a>

                        </li>

                    {% endfor %}

                    {# Вперёд #}
                    <li class="page-item {{ page == totalPages ? 'disabled' : '' }}">

                        {% if page < totalPages %}

                            <a
                                class="page-link"
                                href="{{ path('app_tickets', {
                                page: page + 1,
                                status: selectedStatusId ?? 'all'
                            }) }}"
                            >
                                Вперёд →
                            </a>

                        {% else %}

                            <span class="page-link">
                                Вперёд →
                            </span>

                        {% endif %}

                    </li>

                </ul>

            </nav>

        {% endif %}

    </div>

{% endblock %}