{% extends 'base.html.twig' %}

{% block title %}
    Редактирование заявки #{{ ticket.id }} | IT Service Desk
{% endblock %}

{% block body %}

    {# Определяем оформление статуса #}
    {% set statusClass = 'isd-ticket-status-default' %}

    {% if ticket.status.name == 'Новая' %}
        {% set statusClass = 'isd-ticket-status-new' %}
    {% elseif ticket.status.name == 'В работе' %}
        {% set statusClass = 'isd-ticket-status-progress' %}
    {% elseif ticket.status.name == 'Решена' %}
        {% set statusClass = 'isd-ticket-status-resolved' %}
    {% elseif ticket.status.name == 'Закрыта' %}
        {% set statusClass = 'isd-ticket-status-closed' %}
    {% endif %}

    <div class="isd-tickets isd-ticket-edit">

        {# Заголовок #}
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

            <div>
                <span class="isd-tickets-kicker">
                    УПРАВЛЕНИЕ ЗАЯВКАМИ
                </span>

                <h1 class="h2 fw-bold mt-2 mb-2">
                    Редактирование заявки #{{ ticket.id }}
                </h1>

                <p class="isd-tickets-description mb-0">
                    Изменение информации об обращении.
                </p>
            </div>

            <a
                href="{{ path('find_tickets', {id: ticket.id}) }}"
                class="btn isd-tickets-secondary"
            >
                ← Назад к заявке
            </a>

        </div>

        <div class="row g-4">

            {# Левая часть — основные данные #}
            <div class="col-lg-8">

                <section class="card isd-register-card h-100">

                    <div class="card-header p-4">
                        <h2 class="h5 fw-bold mb-2">
                            Основная информация
                        </h2>

                        <p class="isd-tickets-description small mb-0">
                            Обновите название или описание заявки.
                        </p>
                    </div>

                    <div class="card-body p-4">

                        {{ form_start(form, {
                        attr: {
                            class: 'isd-register-form'
                        }
                    }) }}

                        {{ form_errors(form) }}

                        {# Название заявки #}
                        <div class="isd-register-field mb-4">

                            {{ form_row(form.title, {
                                label: 'Название заявки',
                                attr: {
                                    class: 'form-control isd-register-input'
                                }
                            }) }}

                        </div>

                        {# Описание заявки #}
                        <div class="isd-register-field mb-4">

                            {{ form_row(form.description, {
                                label: 'Описание проблемы',
                                attr: {
                                    class: 'form-control isd-register-input',
                                    rows: 7
                                }
                            }) }}

                        </div>

                        <div class="isd-register-note mb-4">
                            <span aria-hidden="true">ℹ️</span>

                            <span>
                                Изменение названия и описания
                                не изменяет текущий статус заявки.
                                Для статуса предусмотрено отдельное действие.
                            </span>
                        </div>

                        <div class="d-flex flex-wrap gap-3">

                            <button
                                type="submit"
                                class="btn isd-register-submit"
                            >
                                Сохранить изменения
                            </button>

                            <a
                                href="{{ path('find_tickets', {id: ticket.id}) }}"
                                class="btn isd-register-back"
                            >
                                Отмена
                            </a>

                        </div>

                        {{ form_end(form) }}

                    </div>

                </section>

            </div>

            {# Правая часть — статус и дополнительные действия #}
            <div class="col-lg-4">

                <div class="d-flex flex-column gap-4">

                    {# Текущий статус заявки #}
                    <section class="card isd-tickets-panel">

                        <div class="card-header p-4">
                            <h2 class="h5 fw-bold mb-0">
                                Статус заявки
                            </h2>
                        </div>

                        <div class="card-body p-4">

                            <p class="isd-tickets-description small mb-3">
                                Текущее состояние обращения
                            </p>

                            <div class="mb-4">

                                <span class="isd-ticket-status {{ statusClass }}">

                                    <span
                                        class="isd-ticket-status-dot"
                                        aria-hidden="true"
                                    ></span>

                                    {{ ticket.status.name }}

                                </span>

                            </div>

                            {% if is_granted('CHANGE_STATUS', ticket) %}

                                <a
                                    href="{{ path('app_tickets_status', {id: ticket.id}) }}"
                                    class="btn isd-ticket-detail-status-button w-100"
                                >
                                    Изменить статус →
                                </a>

                            {% else %}

                                <p class="isd-tickets-description small mb-0">
                                    Изменение статуса недоступно
                                    для вашей роли или данной заявки.
                                </p>

                            {% endif %}

                        </div>

                    </section>

                    {# Удаление заявки #}
                    {% if is_granted('DELETE', ticket) %}

                        <section class="card isd-tickets-panel isd-ticket-edit-danger">

                            <div class="card-header p-4">

                                <h2 class="h5 fw-bold mb-0">
                                    Опасная зона
                                </h2>

                            </div>

                            <div class="card-body p-4">

                                <p class="isd-tickets-description small mb-3">
                                    Удаление заявки является
                                    необратимым действием.
                                </p>

                                <form
                                    action="{{ path('app_tickets_delete', {id: ticket.id}) }}"
                                    method="post"
                                    onsubmit="return confirm('Вы уверены, что хотите удалить заявку?');"
                                >

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('delete_ticket_' ~ ticket.id) }}"
                                    >

                                    <button
                                        type="submit"
                                        class="btn btn-danger w-100"
                                    >
                                        Удалить заявку
                                    </button>

                                </form>

                            </div>

                        </section>

                    {% endif %}

                </div>

            </div>

        </div>

    </div>

{% endblock %}