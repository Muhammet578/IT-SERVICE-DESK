{% extends 'base.html.twig' %}

{% block title %}Редактирование заявки{% endblock %}

{% block body %}
    <div class="container py-4">

        <h1 class="h3 mb-4">
            Редактирование заявки #{{ ticket.id }}
        </h1>

        <div class="card shadow-sm">
            <div class="card-body">

                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_row(form.title) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.description) }}
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Сохранить изменения
                    </button>

                    <a
                        href="{{ path('find_tickets', {id: ticket.id}) }}"
                        class="btn btn-secondary"
                    >
                        Отмена
                    </a>

                {{ form_end(form) }}
                {% if is_granted('DELETE', ticket) %}

                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-danger mb-1">
                                Удаление заявки
                            </h6>

                            <small class="text-muted">
                                Это действие нельзя отменить.
                            </small>
                        </div>

                        <form
                            action="{{ path('app_tickets_delete', {id: ticket.id}) }}"
                            method="post"
                            onsubmit="return confirm('Вы уверены, что хотите удалить заявку?');"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('delete_ticket_' ~ ticket.id) }}"
                            >

                            <button
                                type="submit"
                                class="btn btn-danger"
                            >
                                Удалить заявку
                            </button>
                        </form>

                    </div>

                {% endif %}

            </div>
        </div>

    </div>
{% endblock %}