{% extends 'base.html.twig' %}

{% block title %}Изменение статуса | IT Service Desk{% endblock %}

{% block body %}
    <div class="container py-4">

        <h1 class="h3 fw-semibold mb-4">
            Изменение статуса заявки #{{ ticket.id }}
        </h1>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h5 class="mb-3">
                    {{ ticket.title }}
                </h5>

                <p class="text-muted">
                    Текущий статус:
                    <strong>{{ ticket.status.name }}</strong>
                </p>

                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_row(form.status) }}
                    </div>

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >
                        Сохранить статус
                    </button>

                    <a
                        href="{{ path('find_tickets', {id: ticket.id}) }}"
                        class="btn btn-outline-secondary"
                    >
                        Отмена
                    </a>

                {{ form_end(form) }}

            </div>
        </div>

    </div>
{% endblock %}