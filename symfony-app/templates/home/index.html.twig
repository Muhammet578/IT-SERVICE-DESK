{% extends 'base.html.twig' %}

{% block title %}Главная | IT Service Desk{% endblock %}

{% block body %}

    <div class="isd-home">

        {# Приветственный блок #}
        <section class="isd-home-hero rounded-4 mb-5">

            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="isd-home-eyebrow">
                        ● СИСТЕМА ТЕХНИЧЕСКОЙ ПОДДЕРЖКИ
                    </span>

                    <h1 class="display-5 fw-bold mt-4 mb-3">
                        Поддержка сотрудников.
                        <span class="isd-home-hero-highlight">
                            Управление без хаоса.
                        </span>
                    </h1>

                    <p class="isd-home-hero-description fs-5 mb-4">
                        IT Service Desk — единое пространство
                        для управления заявками, сотрудниками
                        и рабочими процессами технической поддержки.
                    </p>

                    <div class="d-flex flex-wrap gap-3">

                        <a
                            href="{{ path('app_tickets') }}"
                            class="btn isd-home-hero-primary btn-lg"
                        >
                            Перейти к заявкам
                            <span aria-hidden="true">→</span>
                        </a>

                        {% if is_granted('ROLE_ADMIN') %}
                            <a
                                href="{{ path('app_users') }}"
                                class="btn isd-home-hero-secondary btn-lg"
                            >
                                Пользователи
                            </a>
                        {% elseif is_granted('ROLE_MANAGER') %}
                            <a
                                href="{{ path('app_users_new') }}"
                                class="btn isd-home-hero-secondary btn-lg"
                            >
                                + Новый пользователь
                            </a>
                        {% else %}
                            <a
                                href="{{ path('app_profile') }}"
                                class="btn isd-home-hero-secondary btn-lg"
                            >
                                Мой профиль
                            </a>
                        {% endif %}

                    </div>

                </div>

                {# Декоративный блок #}
                <div class="col-lg-4 d-none d-lg-block">

                    <div class="isd-home-hero-visual">

                        <div class="isd-home-visual-icon">
                            IT
                        </div>

                        <div class="isd-home-visual-title">
                            SERVICE DESK
                        </div>

                        <div class="isd-home-visual-subtitle">
                            Управление IT-поддержкой
                        </div>

                        <div class="isd-home-visual-tags">
                            <span>Заявки</span>
                            <span>Статусы</span>
                            <span>Приоритеты</span>
                        </div>

                    </div>

                </div>

            </div>

        </section>

        {# Возможности системы #}
        <section class="mb-5">

            <div class="isd-home-section-heading mb-4">

                <div>
                    <span class="isd-home-section-kicker">
                        ВОЗМОЖНОСТИ
                    </span>

                    <h2 class="h3 fw-bold mt-2 mb-2">
                        Всё необходимое для работы
                    </h2>

                    <p class="isd-home-section-description mb-0">
                        Основные инструменты управления технической поддержкой.
                    </p>
                </div>

            </div>

            <div class="row g-4">

                {# Карточка заявок #}
                <div class="col-md-6 col-xl-4">

                    <div class="card isd-home-feature h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="isd-home-feature-icon isd-home-icon-ticket">
                                🎫
                            </div>

                            <h3 class="h5 fw-bold mt-4 mb-3">
                                Управление заявками
                            </h3>

                            <p class="isd-home-feature-description mb-4">
                                Отслеживайте обращения,
                                просматривайте категории,
                                приоритеты и текущие статусы заявок.
                            </p>

                            <a
                                href="{{ path('app_tickets') }}"
                                class="isd-home-feature-link mt-auto"
                            >
                                Открыть заявки
                                <span aria-hidden="true">→</span>
                            </a>

                        </div>

                    </div>

                </div>

                {# Карточка пользователей #}
                <div class="col-md-6 col-xl-4">

                    <div class="card isd-home-feature h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="isd-home-feature-icon isd-home-icon-users">
                                👥
                            </div>

                            <h3 class="h5 fw-bold mt-4 mb-3">
                                Пользователи и роли
                            </h3>

                            <p class="isd-home-feature-description mb-4">
                                Управление учётными записями,
                                ролями и разрешениями сотрудников
                                в соответствии с правами доступа.
                            </p>

                            {% if is_granted('ROLE_ADMIN') %}

                                <a
                                    href="{{ path('app_users') }}"
                                    class="isd-home-feature-link mt-auto"
                                >
                                    Список пользователей
                                    <span aria-hidden="true">→</span>
                                </a>

                            {% elseif is_granted('ROLE_MANAGER') %}

                                <a
                                    href="{{ path('app_users_new') }}"
                                    class="isd-home-feature-link mt-auto"
                                >
                                    Создать пользователя
                                    <span aria-hidden="true">→</span>
                                </a>

                            {% else %}

                                <a
                                    href="{{ path('app_profile') }}"
                                    class="isd-home-feature-link mt-auto"
                                >
                                    Мой профиль
                                    <span aria-hidden="true">→</span>
                                </a>

                            {% endif %}

                        </div>

                    </div>

                </div>

                {# Карточка безопасности #}
                <div class="col-md-6 col-xl-4">

                    <div class="card isd-home-feature h-100">

                        <div class="card-body p-4 d-flex flex-column">

                            <div class="isd-home-feature-icon isd-home-icon-security">
                                🛡️
                            </div>

                            <h3 class="h5 fw-bold mt-4 mb-3">
                                Безопасность
                            </h3>

                            <p class="isd-home-feature-description mb-4">
                                Авторизация через Symfony Security,
                                проверка ролей, TicketVoter,
                                CSRF-защита и контроль активности аккаунтов.
                            </p>

                            <a
                                href="{{ path('app_about') }}"
                                class="isd-home-feature-link mt-auto"
                            >
                                О проекте
                                <span aria-hidden="true">→</span>
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        {# Нижний блок быстрого перехода #}
        <section class="card isd-home-bottom mb-4">

            <div class="card-body p-4 p-md-5">

                <div class="row align-items-center g-4">

                    <div class="col-md-8">

                        <span class="isd-home-section-kicker">
                            БЫСТРЫЙ ДОСТУП
                        </span>

                        <h2 class="h4 fw-bold mt-2 mb-2">
                            Готовы приступить к работе?
                        </h2>

                        <p class="isd-home-section-description mb-0">
                            Перейдите к доступным вам заявкам,
                            проверьте их статусы и продолжите
                            работу с обращениями.
                        </p>

                    </div>

                    <div class="col-md-4 text-md-end">

                        <a
                            href="{{ path('app_tickets') }}"
                            class="btn isd-home-bottom-button px-4 py-2"
                        >
                            Начать работу
                            <span aria-hidden="true">→</span>
                        </a>

                    </div>

                </div>

            </div>

        </section>

    </div>

{% endblock %}