{% extends 'base.html.twig' %}

{% block title %}Главная | IT Service Desk{% endblock %}

{% block body %}
    <main class="py-4">

        {# Приветственный блок #}
        <section
            class="rounded-4 p-4 p-md-5 mb-4 text-white shadow-sm"
            style="background: linear-gradient(125deg, #0d6efd, #173c85);"
        >
            <div class="row align-items-center g-4">

                <div class="col-lg-8">

                    <span class="badge bg-white text-primary mb-3 px-3 py-2">
                        Система технической поддержки
                    </span>

                    <h1 class="display-5 fw-bold mb-3">
                        {{ project_name }}
                    </h1>

                    <p class="fs-5 text-white mb-4" style="opacity: 0.9;">
                        Единое пространство для управления
                        заявками, пользователями и рабочими
                        процессами IT-поддержки.
                    </p>

                    <div class="d-flex flex-wrap gap-2">

                        {# Заявки доступны всем авторизованным пользователям #}
                        <a
                            href="{{ path('app_tickets') }}"
                            class="btn btn-light btn-lg fw-semibold"
                        >
                            Перейти к заявкам
                        </a>

                        {# Список пользователей — администратору #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a
                                href="{{ path('app_users') }}"
                                class="btn btn-outline-light btn-lg"
                            >
                                Пользователи
                            </a>
                        {% endif %}

                        {# Создание пользователей — менеджеру и администратору #}
                        {% if is_granted('ROLE_MANAGER') %}
                            <a
                                href="{{ path('app_users_new') }}"
                                class="btn btn-outline-light btn-lg"
                            >
                                + Новый пользователь
                            </a>
                        {% endif %}

                    </div>
                </div>

                <div class="col-lg-4 text-center d-none d-lg-block">
                    <div class="display-1" aria-hidden="true">
                        🖥️
                    </div>
                    <p class="mt-3 mb-0 text-white-50">
                        IT Service Management
                    </p>
                </div>

            </div>
        </section>

        {# Возможности системы #}
        <section class="mb-4">

            <div class="mb-4">
                <h2 class="h3 fw-bold mb-2">
                    Возможности системы
                </h2>

                <p class="text-muted">
                    Основные инструменты для организации
                    технической поддержки.
                </p>
            </div>

            <div class="row g-4">

                {# Заявки #}
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">

                            <div class="fs-1 mb-3" aria-hidden="true">
                                🎫
                            </div>

                            <h3 class="h5 fw-bold">
                                Управление заявками
                            </h3>

                            <p class="text-muted">
                                Просмотр обращений сотрудников,
                                категорий, приоритетов и статусов
                                заявок технической поддержки.
                            </p>

                            <a
                                href="{{ path('app_tickets') }}"
                                class="btn btn-outline-primary btn-sm"
                            >
                                Перейти к заявкам
                            </a>

                        </div>
                    </div>
                </div>

                {# Пользователи #}
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">

                            <div class="fs-1 mb-3" aria-hidden="true">
                                👥
                            </div>

                            <h3 class="h5 fw-bold">
                                Пользователи
                            </h3>

                            <p class="text-muted">
                                Управление учётными записями,
                                ролями и доступом сотрудников
                                к системе.
                            </p>

                            {% if is_granted('ROLE_ADMIN') %}
                                <a
                                    href="{{ path('app_users') }}"
                                    class="btn btn-outline-primary btn-sm"
                                >
                                    Список пользователей
                                </a>

                            {% elseif is_granted('ROLE_MANAGER') %}
                                <a
                                    href="{{ path('app_users_new') }}"
                                    class="btn btn-outline-primary btn-sm"
                                >
                                    Добавить пользователя
                                </a>

                            {% else %}
                                <a
                                    href="{{ path('app_profile') }}"
                                    class="btn btn-outline-primary btn-sm"
                                >
                                    Мой профиль
                                </a>
                            {% endif %}

                        </div>
                    </div>
                </div>

                {# Безопасность #}
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">

                            <div class="fs-1 mb-3" aria-hidden="true">
                                🛡️
                            </div>

                            <h3 class="h5 fw-bold">
                                Надёжная архитектура
                            </h3>

                            <p class="text-muted mb-0">
                                Symfony, Twig, Doctrine ORM,
                                валидация форм, разграничение
                                доступа и защита данных.
                            </p>

                        </div>
                    </div>
                </div>

            </div>
        </section>

        {# Нижний информационный блок #}
        <section class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">

                <div class="row align-items-center g-3">

                    <div class="col-md-8">

                        <h2 class="h5 fw-bold mb-2">
                            Начните работу с системой
                        </h2>

                        <p class="text-muted mb-0">
                            Откройте список доступных вам заявок,
                            просмотрите их статусы и приступайте
                            к работе с обращениями.
                        </p>

                    </div>

                    <div class="col-md-4 text-md-end">
                        <a
                            href="{{ path('app_tickets') }}"
                            class="btn btn-primary px-4"
                        >
                            Начать работу
                        </a>
                    </div>

                </div>

            </div>
        </section>

    </main>
{% endblock %}