{% extends 'base.html.twig' %}

{% block title %}Панель управления | IT Service Desk{% endblock %}

{% block body %}
    <main class="py-4">

        <div class="mb-4">
            <h1 class="h3 fw-semibold mb-2">Панель управления</h1>
            <p class="text-muted mb-0">
                {{ project_name }} — управление пользователями и заявками.
            </p>
        </div>
        <div class="row g-3 mb-4">

            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-2">
                            Пользователи
                        </div>
                        <h2 class="h3 fw-bold mb-0">
                            {{ stats.usersCount }}
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-2">
                            Всего заявок
                        </div>
                        <h2 class="h3 fw-bold mb-0">
                            {{ stats.ticketsCount }}
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-2">
                            Незавершённые заявки
                        </div>
                        <h2 class="h3 fw-bold text-warning mb-0">
                            {{ stats.openTicketsCount }}
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-2">
                            Завершённые заявки
                        </div>
                        <h2 class="h3 fw-bold text-success mb-0">
                            {{ stats.closedTicketsCount }}
                        </h2>
                    </div>
                </div>
            </div>

        </div>
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">

                <form
                    action="{{ path('app_dashboard') }}"
                    method="get"
                    class="row g-3 align-items-end"
                >

                    <div class="col-md-8">
                        <label
                            for="dashboard-period"
                            class="form-label fw-semibold"
                        >
                            Период статистики
                        </label>

                        <select
                            id="dashboard-period"
                            name="period"
                            class="form-select"
                        >
                            <option
                                value="7"
                                {{ selectedPeriod == '7' ? 'selected' : '' }}
                            >
                                Последние 7 дней
                            </option>

                            <option
                                value="30"
                                {{ selectedPeriod == '30' ? 'selected' : '' }}
                            >
                                Последние 30 дней
                            </option>

                            <option
                                value="all"
                                {{ selectedPeriod == 'all' ? 'selected' : '' }}
                            >
                                За всё время
                            </option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <button
                            type="submit"
                            class="btn btn-primary w-100"
                        >
                            Применить
                        </button>
                    </div>

                </form>

            </div>
        </div>

        {# Средний показатель #}
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="text-muted small mb-2">
                    Среднее количество заявок на пользователя
                </div>

                <div class="h4 fw-bold mb-0">
                    {{ stats.averageTicketsPerUser|number_format(2, ',', ' ') }}
                </div>
            </div>
        </div>

        {# Рейтинги #}
        <div class="row g-4 mb-4">

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h2 class="h5 mb-0">
                            Топ-5 пользователей
                        </h2>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Пользователь</th>
                                    <th class="text-end">Заявки</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in stats.topUsers %}
                                    <tr>
                                        <td>{{ user.name }}</td>
                                        <td class="text-end">
                                            {{ user.ticketsCount }}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="2">
                                            Нет данных
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h2 class="h5 mb-0">
                            Топ-5 категорий
                        </h2>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Категория</th>
                                    <th class="text-end">Заявки</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for category in stats.topCategories %}
                                    <tr>
                                        <td>{{ category.name }}</td>
                                        <td class="text-end">
                                            {{ category.ticketsCount }}
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="2">
                                            Нет данных
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
        <div class="row g-4">

            {# Основные разделы #}
            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h2 class="h5 mb-0">Основные разделы</h2>
                    </div>

                    <div class="list-group list-group-flush">

                        <a
                            href="{{ path('app_tickets') }}"
                            class="list-group-item list-group-item-action p-3"
                        >
                            <div class="fw-semibold">Заявки</div>
                            <small class="text-muted">
                                Просмотр обращений и их текущих статусов
                            </small>
                        </a>

                        <a
                            href="{{ path('app_users') }}"
                            class="list-group-item list-group-item-action p-3"
                        >
                            <div class="fw-semibold">Пользователи</div>
                            <small class="text-muted">
                                Просмотр, поиск и редактирование пользователей
                            </small>
                        </a>

                    </div>
                </div>
            </div>

            {# Быстрые действия #}
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white py-3">
                        <h2 class="h5 mb-0">Быстрые действия</h2>
                    </div>

                    <div class="card-body">
                        <p class="text-muted small">
                            Выберите необходимое действие.
                        </p>

                        <div class="d-grid gap-2">
                            <a
                                href="{{ path('app_users_new') }}"
                                class="btn btn-primary"
                            >
                                Добавить пользователя
                            </a>

                            <a
                                href="{{ path('app_tickets') }}"
                                class="btn btn-outline-secondary"
                            >
                                Просмотреть заявки
                            </a>

                            <a
                                href="{{ path('app_users') }}"
                                class="btn btn-outline-secondary"
                            >
                                Список пользователей
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        {# Информация о системе #}
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-white py-3">
                <h2 class="h5 mb-0">Информация о системе</h2>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <h3 class="h6 fw-semibold">
                            Управление пользователями
                        </h3>

                        <p class="text-muted small mb-0">
                            Создание и редактирование записей,
                            поиск по имени и email, сортировка списка.
                        </p>
                    </div>

                    <div class="col-md-6">
                        <h3 class="h6 fw-semibold">
                            Учёт заявок
                        </h3>

                        <p class="text-muted small mb-0">
                            Просмотр заявок технической поддержки,
                            их категорий, статусов и приоритетов.
                        </p>
                    </div>

                </div>
            </div>
        </div>

    </main>
{% endblock %}
